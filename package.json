{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "pnpm -F @workspace/api-server run start",
    "dev": "pnpm -F @workspace/db run push && pnpm -F @workspace/api-server run dev & pnpm -F @workspace/draxelyra run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . || true",
    "docs:dev": "docusaurus start",
    "docs:build": "docusaurus build",
    "docs:serve": "docusaurus serve"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@mermaid-js/layout-elk": "^0.2.3",
    "@playwright/test": "^1.62.1",
    "@rollup/rollup-win32-x64-msvc": "^4.62.5",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "clsx": "catalog:",
    "eslint": "^10.9.0",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prism-react-renderer": "^2.4.1",
    "tsx": "catalog:",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
