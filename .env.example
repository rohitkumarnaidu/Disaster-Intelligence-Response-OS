# =============================================================================
# DRAXELYRA Environment Configuration Template
# Copy this file to .env and configure the variables. Do not commit actual secrets.
# =============================================================================

# --- Core Server & Runtime ---
NODE_ENV=development
PORT=3000
VITE_PORT=5173
BASE_PATH=/
LOG_LEVEL=info

# --- Database & Session Security ---
# Local Docker: postgresql://postgres:postgres@localhost:5433/draxelyra
# Railway Cloud: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/draxelyra
SESSION_SECRET=your_secure_random_session_secret_here

# --- Google Gemini Multimodal AI (Optional - for real AI damage assessment) ---
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER_DEFAULT=gemini-multimodal

# --- Copernicus Data Space Ecosystem (CDSE) — Sentinel-1/2 Satellites ---
# Register at: https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# --- Sentinel Hub Processing API (Optional) ---
# Register at: https://services.sentinel-hub.com/
SENTINEL_PROCESSING_CLIENT_ID=
SENTINEL_PROCESSING_CLIENT_SECRET=

# --- NASA FIRMS (Wildfire Thermal Anomalies & Active Fires) ---
# Get free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# --- OpenWeatherMap (Atmospheric Radar & Pressure) ---
# Get free API key at: https://openweathermap.org/api (1,000 calls/day free)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# --- WAQI Air Quality Index (Post-Disaster Particulate & Toxicity) ---
# Get free token at: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=your_waqi_api_token_here

# --- India Meteorological Department (IMD) & SACHET NDMA Feeds ---
IMD_API_KEY=
IMD_API_BASE_URL=
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_feed/rss.xml

# --- Geospatial & OpenStreetMap ---
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
MAPTILER_API_KEY=

# --- Ingestion Engine & Background Polling Configuration ---
INGESTION_ENABLED=true
DATA_MODE_DEFAULT=REAL
INGESTION_INTERVAL_EARTHQUAKES_MS=300000
INGESTION_INTERVAL_WEATHER_MS=600000
INGESTION_INTERVAL_GDACS_MS=900000
INGESTION_DEFAULT_LAT=13.08
INGESTION_DEFAULT_LNG=80.27
INGESTION_RADIUS_KM=500
