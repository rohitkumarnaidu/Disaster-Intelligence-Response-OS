# DRAXELYRA Environment Configuration Template
# Copy this file to .env and configure the variables. Do not commit actual secrets.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/draxelyra
SESSION_SECRET=your_secure_random_session_secret_here
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
VITE_PORT=5173
BASE_PATH=/

# Copernicus Data Space Ecosystem (CDSE) — https://dataspace.copernicus.eu/
# OAuth2 Client Credentials for Sentinel-1/Sentinel-2 STAC and OData access
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Sentinel Hub Processing API — https://services.sentinel-hub.com/
SENTINEL_PROCESSING_CLIENT_ID=
SENTINEL_PROCESSING_CLIENT_SECRET=

# OpenStreetMap Overpass Interpreter
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Default Operating Data Mode (REAL vs DEMO)
DATA_MODE_DEFAULT=REAL

# External API Keys (register for free at each provider)
# OpenWeatherMap — https://openweathermap.org/api (1,000 calls/day free)
OPENWEATHERMAP_API_KEY=
# WAQI Air Quality — https://aqicn.org/data-platform/token/ (free token)
WAQI_API_TOKEN=
# NASA FIRMS — https://firms.modaps.eosdis.nasa.gov/api/area/ (free MAP_KEY)
NASA_FIRMS_MAP_KEY=
# MapTiler — https://www.maptiler.com/ (100K requests/month free)
MAPTILER_API_KEY=

# Ingestion Engine Configuration
# Set to false to disable automatic external API polling
INGESTION_ENABLED=true
# Polling intervals in milliseconds
INGESTION_INTERVAL_EARTHQUAKES_MS=300000
INGESTION_INTERVAL_WEATHER_MS=600000
INGESTION_INTERVAL_GDACS_MS=900000
# Default center coordinates for regional ingestion
INGESTION_DEFAULT_LAT=13.08
INGESTION_DEFAULT_LNG=80.27
INGESTION_RADIUS_KM=500
